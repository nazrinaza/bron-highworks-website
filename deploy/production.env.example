APP_NAME="BRON Highworks"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bronhighworks.com
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
